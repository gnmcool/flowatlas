# Copy this file to .env and fill in your own keys.
# cp .env.example .env

# FRED API key — free, powers the HY OAS credit factor in Fear & Greed
# and the 2s10s yield-curve spread
# Get one at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub API key — optional
# Get one at: https://finnhub.io/register
FINNHUB_API_KEY=

# Upstash Redis — persists the unique-visitor count across redeploys.
# Optional: without these the counter falls back to a local file, which works
# fine on your own machine but resets on every deploy to an ephemeral host.
# Free tier at https://upstash.com → create a Redis database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port the server listens on (defaults to 8787)
PORT=8787
